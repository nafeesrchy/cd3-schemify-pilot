{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.org/cd3-mws-pilot/recruitment/categories/breast_health.json",
  "title": "MWS Recruitment — Breast Health",
  "description": "Breast screening attendance, family history of breast cancer, and personal history of breast cancer recorded at recruitment.",
  "type": "object",
  "x-variable-group": "breast_health",
  "properties": {
    "RMAMM": {
      "title": "Previously attended breast screening",
      "oneOf": [
        {
          "const": 1,
          "title": "Yes"
        },
        {
          "const": 2,
          "title": "No"
        },
        {
          "type": "null",
          "title": "No value recorded"
        }
      ]
    },
    "RFHBC": {
      "title": "Mother or sister with breast cancer",
      "description": "Derived field.",
      "oneOf": [
        {
          "const": 1,
          "title": "Yes"
        },
        {
          "const": 2,
          "title": "No"
        },
        {
          "type": "null",
          "title": "No value recorded"
        }
      ]
    },
    "RBRCA": {
      "title": "Ever had breast cancer",
      "oneOf": [
        {
          "const": 1,
          "title": "Yes"
        },
        {
          "const": 2,
          "title": "No"
        },
        {
          "const": 3,
          "title": "Don't know"
        },
        {
          "type": "null",
          "title": "No value recorded"
        }
      ]
    }
  },
  "required": [
    "RMAMM",
    "RFHBC",
    "RBRCA"
  ]
}
