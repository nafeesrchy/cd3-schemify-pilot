{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.org/cd3-mws-pilot/recruitment/recruitment.schema.json",
  "title": "MWS — RECRUITMENT table",
  "description": "Array of Million Women Study baseline records. One element is one participant's baseline recruitment-questionnaire data, spanning three source sheets: Basic information, Recruitment variables, Self-reported health at recruit. Later-wave resurvey sheets are out of scope for this package.",
  "$comment": "This table has no participant-identifier field in the source dictionary at all (open item, see DECISIONS.md D007) -- uniqueItems is asserted as standing structural policy but cannot anchor to a real key here. Standard JSON Schema cannot enforce cross-row identifier uniqueness in any case; see the README's 'Documented but not enforced' section once written.",
  "type": "array",
  "minItems": 1,
  "uniqueItems": true,
  "items": {
    "type": "object",
    "title": "RECRUITMENT record",
    "allOf": [
      {
        "$ref": "categories/demographics.json"
      },
      {
        "$ref": "categories/socioeconomic.json"
      },
      {
        "$ref": "categories/anthropometric.json"
      },
      {
        "$ref": "categories/behavioral.json"
      },
      {
        "$ref": "categories/reproductive_hormonal.json"
      },
      {
        "$ref": "categories/breast_health.json"
      },
      {
        "$ref": "categories/gynae_surgery.json"
      },
      {
        "$ref": "categories/medical_history.json"
      },
      {
        "$comment": "Skip pattern: never had children means number of full-term pregnancies, age at first/last birth, and the whole breastfeeding block are all structurally not applicable -- D041, steward-confirmed. This is the outer gate; RBFYN's own nested gate over RBFNUM/RBFDUR (below) still applies within the RANYCHLD=1 branch.",
        "if": {
          "required": [
            "RANYCHLD"
          ],
          "properties": {
            "RANYCHLD": {
              "const": 2
            }
          }
        },
        "then": {
          "properties": {
            "RNUMFTP": {
              "type": "null"
            },
            "RAGEFB": {
              "type": "null"
            },
            "RAGELB": {
              "type": "null"
            },
            "RBFYN": {
              "type": "null"
            },
            "RBFNUM": {
              "type": "null"
            },
            "RBFDUR": {
              "type": "null"
            }
          }
        }
      },
      {
        "$comment": "Applicability: a participant who has ever had children must have real values for RNUMFTP/RAGEFB/RAGELB/RBFYN, never the structural-NA code. RBFNUM/RBFDUR are deliberately excluded here -- their applicability is governed by the nested RBFYN=1 rule below, not directly by RANYCHLD (RANYCHLD=1 alone doesn't guarantee RBFYN=1) -- D041.",
        "if": {
          "required": [
            "RANYCHLD"
          ],
          "properties": {
            "RANYCHLD": {
              "const": 1
            }
          }
        },
        "then": {
          "properties": {
            "RNUMFTP": {
              "not": {
                "type": "null"
              }
            },
            "RAGEFB": {
              "not": {
                "type": "null"
              }
            },
            "RAGELB": {
              "not": {
                "type": "null"
              }
            },
            "RBFYN": {
              "not": {
                "type": "null"
              }
            }
          }
        }
      },
      {
        "$comment": "Skip pattern: not currently/never breastfed means breastfeeding count and duration are structurally not applicable -- D037, steward-confirmed.",
        "if": {
          "required": [
            "RBFYN"
          ],
          "properties": {
            "RBFYN": {
              "const": 2
            }
          }
        },
        "then": {
          "properties": {
            "RBFNUM": {
              "type": "null"
            },
            "RBFDUR": {
              "type": "null"
            }
          }
        }
      },
      {
        "$comment": "Applicability: a participant who has ever breastfed must have a real value or an item-missing code for RBFNUM/RBFDUR, never the structural-NA code -- D037.",
        "if": {
          "required": [
            "RBFYN"
          ],
          "properties": {
            "RBFYN": {
              "const": 1
            }
          }
        },
        "then": {
          "properties": {
            "RBFNUM": {
              "not": {
                "type": "null"
              }
            },
            "RBFDUR": {
              "not": {
                "type": "null"
              }
            }
          }
        }
      },
      {
        "$comment": "Skip pattern: never used oral contraceptives means start age, stop age, and duration are structurally not applicable -- D038, steward-confirmed (validated against the real questionnaire's own skip logic).",
        "if": {
          "required": [
            "ROC"
          ],
          "properties": {
            "ROC": {
              "const": 2
            }
          }
        },
        "then": {
          "properties": {
            "ROCSTART": {
              "type": "null"
            },
            "ROCSTOP": {
              "type": "null"
            },
            "ROCDUR": {
              "type": "null"
            }
          }
        }
      },
      {
        "$comment": "Applicability: a participant who has ever used oral contraceptives must have real values or item-missing codes for ROCSTART/ROCSTOP/ROCDUR, never the structural-NA code -- D038.",
        "if": {
          "required": [
            "ROC"
          ],
          "properties": {
            "ROC": {
              "const": 1
            }
          }
        },
        "then": {
          "properties": {
            "ROCSTART": {
              "not": {
                "type": "null"
              }
            },
            "ROCSTOP": {
              "not": {
                "type": "null"
              }
            },
            "ROCDUR": {
              "not": {
                "type": "null"
              }
            }
          }
        }
      },
      {
        "$comment": "Skip pattern: never used HRT means start age, duration, last-used age, prior-periods-stopped flag, type, and time-since-last-used are all structurally not applicable -- D039, steward-confirmed.",
        "if": {
          "required": [
            "RHTNPC"
          ],
          "properties": {
            "RHTNPC": {
              "const": 1
            }
          }
        },
        "then": {
          "properties": {
            "RHRTSTA": {
              "type": "null"
            },
            "RHTDUR": {
              "type": "null"
            },
            "RHRTSTO": {
              "type": "null"
            },
            "RHRTMP": {
              "type": "null"
            },
            "RHTTYPE": {
              "type": "null"
            },
            "RHTLU": {
              "type": "null"
            }
          }
        }
      },
      {
        "$comment": "Applicability: a participant who has ever used HRT (Past or Current) must have real values for start age, duration, prior-periods-stopped, and type, never the structural-NA code -- D039.",
        "if": {
          "required": [
            "RHTNPC"
          ],
          "properties": {
            "RHTNPC": {
              "enum": [
                2,
                3
              ]
            }
          }
        },
        "then": {
          "properties": {
            "RHRTSTA": {
              "not": {
                "type": "null"
              }
            },
            "RHTDUR": {
              "not": {
                "type": "null"
              }
            },
            "RHRTMP": {
              "not": {
                "type": "null"
              }
            },
            "RHTTYPE": {
              "not": {
                "type": "null"
              }
            }
          }
        }
      },
      {
        "$comment": "HRT routing: a participant currently using HRT has not stopped, so age-last-used and time-since-last-used are structurally not applicable -- D039, steward-confirmed via the real questionnaire wording ('are you using HRT? If no, how old were you when you last used it?').",
        "if": {
          "required": [
            "RHTNPC"
          ],
          "properties": {
            "RHTNPC": {
              "const": 3
            }
          }
        },
        "then": {
          "properties": {
            "RHRTSTO": {
              "type": "null"
            },
            "RHTLU": {
              "type": "null"
            }
          }
        }
      },
      {
        "$comment": "Applicability: a participant who stopped using HRT in the past must have real values for age-last-used and time-since-last-used, never the structural-NA code -- D039.",
        "if": {
          "required": [
            "RHTNPC"
          ],
          "properties": {
            "RHTNPC": {
              "const": 2
            }
          }
        },
        "then": {
          "properties": {
            "RHRTSTO": {
              "not": {
                "type": "null"
              }
            },
            "RHTLU": {
              "not": {
                "type": "null"
              }
            }
          }
        }
      },
      {
        "$comment": "Skip pattern: periods that have not stopped (or are irregular) mean age-periods-stopped is structurally not applicable -- D028, steward-confirmed.",
        "if": {
          "required": [
            "RPSTOPYN"
          ],
          "properties": {
            "RPSTOPYN": {
              "enum": [
                2,
                3
              ]
            }
          }
        },
        "then": {
          "properties": {
            "RPSTOPAG": {
              "type": "null"
            }
          }
        }
      },
      {
        "$comment": "Applicability: a participant whose periods have stopped must have a real age or an item-missing code for RPSTOPAG, never the structural-NA code -- D028.",
        "if": {
          "required": [
            "RPSTOPYN"
          ],
          "properties": {
            "RPSTOPYN": {
              "const": 1
            }
          }
        },
        "then": {
          "properties": {
            "RPSTOPAG": {
              "not": {
                "type": "null"
              }
            }
          }
        }
      },
      {
        "$comment": "Skip pattern: no hysterectomy means age at hysterectomy is structurally not applicable -- D030, steward-confirmed.",
        "if": {
          "required": [
            "RHYST"
          ],
          "properties": {
            "RHYST": {
              "const": 2
            }
          }
        },
        "then": {
          "properties": {
            "RHYSTAG": {
              "type": "null"
            }
          }
        }
      },
      {
        "$comment": "Applicability: a participant who has had a hysterectomy must have a real age or an item-missing code for RHYSTAG, never the structural-NA code -- D030.",
        "if": {
          "required": [
            "RHYST"
          ],
          "properties": {
            "RHYST": {
              "const": 1
            }
          }
        },
        "then": {
          "properties": {
            "RHYSTAG": {
              "not": {
                "type": "null"
              }
            }
          }
        }
      },
      {
        "$comment": "Skip pattern: no bilateral oophorectomy means age at oophorectomy is structurally not applicable -- D030, steward-confirmed. Deliberately does NOT include ROOPH=3 (Not sure) -- steward confirmed this stays unconstrained.",
        "if": {
          "required": [
            "ROOPH"
          ],
          "properties": {
            "ROOPH": {
              "const": 2
            }
          }
        },
        "then": {
          "properties": {
            "ROOPHAGE": {
              "type": "null"
            }
          }
        }
      },
      {
        "$comment": "Applicability: a participant who has had a bilateral oophorectomy must have a real age or an item-missing code for ROOPHAGE, never the structural-NA code -- D030.",
        "if": {
          "required": [
            "ROOPH"
          ],
          "properties": {
            "ROOPH": {
              "const": 1
            }
          }
        },
        "then": {
          "properties": {
            "ROOPHAGE": {
              "not": {
                "type": "null"
              }
            }
          }
        }
      },
      {
        "$comment": "Skip pattern: not sterilised means age sterilised is structurally not applicable -- D030, steward-confirmed.",
        "if": {
          "required": [
            "RSTER"
          ],
          "properties": {
            "RSTER": {
              "const": 2
            }
          }
        },
        "then": {
          "properties": {
            "RSTERAGE": {
              "type": "null"
            }
          }
        }
      },
      {
        "$comment": "Applicability: a participant who has been sterilised must have a real age or an item-missing code for RSTERAGE, never the structural-NA code -- D030.",
        "if": {
          "required": [
            "RSTER"
          ],
          "properties": {
            "RSTER": {
              "const": 1
            }
          }
        },
        "then": {
          "properties": {
            "RSTERAGE": {
              "not": {
                "type": "null"
              }
            }
          }
        }
      }
    ],
    "unevaluatedProperties": false
  }
}
