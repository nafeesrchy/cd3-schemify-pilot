        {
          "type": "number"
        },
        {
          "$ref": "../../common/defs.json#/$defs/no_value_recorded"
        }
      ]
    },
    "Creatinine_ntg": {
      "title": "Nightingale - Creatinine",
      "x-unit": "μmol/l",
      "anyOf": [
        {
          "type": "number"
        },
        {
          "$ref": "../../common/defs.json#/$defs/no_value_recorded"
        }
      ]
    },
    "Albumin_ntg": {
      "title": "Nightingale - Albumin",
      "x-unit": "g/l",
      "anyOf": [
        {
          "type": "number"
        },
        {
          "$ref": "../../common/defs.json#/$defs/no_value_recorded"
        }
      ]
    }
