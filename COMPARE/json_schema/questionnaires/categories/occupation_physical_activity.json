{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.org/cd3-compare-pilot/questionnaires/categories/occupation_physical_activity.json",
  "title": "QUESTIONNAIRES — Occupation & Physical Activity",
  "description": "Employment situation, change in physical activity and activity at work and in leisure time, from the questionnaire.",
  "type": "object",
  "x-variable-group": "occupation_physical_activity",
  "$comment": "Items carry the source's own codes; the source gives no 999 for pa_change.",
  "properties": {
    "occupation": {
      "title": "Which of the following best describes your current situation?",
      "oneOf": [
        {
          "const": 1,
          "title": "In full-time employment (paid or unpaid)"
        },
        {
          "const": 2,
          "title": "In part-time employment (paid or unpaid)"
        },
        {
          "const": 3,
          "title": "Do not work (e.g. retired or unemployed or student)"
        },
        {
          "$ref": "../../common/defs.json#/$defs/dont_know_prefer_not_to_answer"
        },
        {
          "$ref": "../../common/defs.json#/$defs/no_value_recorded"
        }
      ]
    },
    "pa_change": {
      "title": "Thinking about your usual levels of physical activity (including general walking, cycling, housework etc.) have you changed these as, a result of giving blood?",
      "oneOf": [
        {
          "const": 1,
          "title": "yes"
        },
        {
          "const": 2,
          "title": "no"
        },
        {
          "$ref": "../../common/defs.json#/$defs/no_value_recorded"
        }
      ],
      "$comment": "Source wording kept as written, including 'as, a result of giving blood'."
    },
    "pa_work": {
      "title": "How do you spend most of your time at work?",
      "oneOf": [
        {
          "const": 1,
          "title": "sitting"
        },
        {
          "const": 2,
          "title": "standing / walking"
        },
        {
          "const": 3,
          "title": "Manual work/some physical effort"
        },
        {
          "const": 4,
          "title": "Heavy manual/physical work"
        },
        {
          "const": 5,
          "title": "do not work"
        },
        {
          "$ref": "../../common/defs.json#/$defs/dont_know_prefer_not_to_answer"
        },
        {
          "$ref": "../../common/defs.json#/$defs/no_value_recorded"
        }
      ]
    },
    "pa_leisure": {
      "title": "Please indicate how active you are outside work (including travel to and from work, activity in the home and in your leisure time)?",
      "oneOf": [
        {
          "const": 1,
          "title": "inactive"
        },
        {
          "const": 2,
          "title": "moderately inactive"
        },
        {
          "const": 3,
          "title": "moderately active"
        },
        {
          "const": 4,
          "title": "very active"
        },
        {
          "$ref": "../../common/defs.json#/$defs/dont_know_prefer_not_to_answer"
        },
        {
          "$ref": "../../common/defs.json#/$defs/no_value_recorded"
        }
      ]
    }
  },
  "required": [
    "occupation",
    "pa_change",
    "pa_work",
    "pa_leisure"
  ]
}
