      },
      {
        "$ref": "questionnaires/categories/fitzpatrick_skin_type.json"
      },
      {
        "$ref": "questionnaires/categories/reproductive_hormonal.json"
      },
      {
        "$ref": "questionnaires/categories/behavioral.json"
      },
      {
        "$ref": "questionnaires/categories/occupation_physical_activity.json"
      },
      {
        "$ref": "questionnaires/categories/blood_donation.json"
      },
      {
        "$ref": "questionnaires/categories/dietary.json"
      },
      {
        "$ref": "questionnaires/categories/general_health.json"
      },
      {
        "$ref": "questionnaires/categories/medical_history.json"
      },
      {
        "$ref": "hb_measurements/categories/haemoglobin_measurements.json"
      },
      {
        "$ref": "bloods/categories/blood_counts_assays_visit_1.json"
      },
      {
        "$ref": "bloods/categories/blood_counts_assays_visit_2.json"
      },
      {
        "$ref": "biomarkers/categories/blood_biomarkers.json"
      },
      {
        "$ref": "omics/categories/omics.json"
      }
    ]
  }
