      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "../../common/defs.json#/$defs/no_value_recorded"
        }
      ],
      "$comment": "Source gives the description only, no Categories text: no date format is stated, so no pattern is asserted and the column is typed as text (D022, D080)."
    }
  },
  "properties": {
