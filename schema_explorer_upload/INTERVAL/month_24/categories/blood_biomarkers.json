{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.org/cd3-interval-pilot/month_24/categories/blood_biomarkers.json",
  "title": "MONTH_24 — Blood Biomarkers",
  "description": "Haematological, lipid and glycaemic biomarkers for the 24-month research blood sample, each with the date the lab processed the sample.",
  "type": "object",
  "x-variable-group": "blood_biomarkers",
  "$comment": "Units are as written in the source. The dictionary states no ranges, so none are asserted; measured values are typed number because no data type is stated (D080).",
