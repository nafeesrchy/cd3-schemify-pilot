{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.org/cd3-ukb-pilot/online_follow_up/online_follow_up.schema.json",
  "title": "UK Biobank: Online follow-up",
  "description": "Array of UK Biobank participant records holding the Showcase top-level category 'Online follow-up'. One element is one participant, keyed by eid, so every table of this package has the same grain and joins to the others on eid. Questions UK Biobank asks at several assessment visits carry only the initial-visit (instance 0) value; the repeat and imaging visits are out of scope. Any column except eid may be null, which is how an empty cell in the delivered data is written (D048).",
  "$comment": "One table per Showcase top-level category (D054). The category files are the Showcase sub-categories as converted. ",
  "type": "array",
  "minItems": 1,
  "uniqueItems": true,
  "items": {
    "type": "object",
    "title": "UK Biobank record (Online follow-up)",
    "allOf": [
      {
        "$ref": "categories/identification.json"
      },
      {
        "$ref": "categories/online_follow_up_sleep_sleep_behaviour.json"
      },
      {
        "$ref": "categories/online_follow_up_sleep_work_and_sleep.json"
      },
      {
        "$ref": "categories/online_follow_up_sleep_quality_of_sleep.json"
      },
      {
        "$ref": "categories/online_follow_up_sleep_insomnia.json"
      },
      {
        "$ref": "categories/online_follow_up_sleep_sleep_disturbances.json"
      },
      {
        "$ref": "categories/online_follow_up_sleep_fatigue.json"
      },
      {
        "$ref": "categories/online_follow_up_sleep_restless_legs.json"
      },
      {
        "$ref": "categories/online_follow_up_sleep_sleep_consequences.json"
      },
      {
        "$ref": "categories/online_follow_up_sleep_family_history.json"
      },
      {
        "$ref": "categories/online_follow_up_sleep_lifestyle_routines.json"
      },
      {
        "$ref": "categories/online_follow_up_mental_well_being_alcohol_use.json"
      },
      {
        "$ref": "categories/online_follow_up_work_environment_medical_information.json"
      },
      {
        "$ref": "categories/online_follow_up_work_environment_employment_history.json"
      }
    ],
    "unevaluatedProperties": false
  }
}
