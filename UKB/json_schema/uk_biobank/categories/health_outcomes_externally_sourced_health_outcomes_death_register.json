{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.org/cd3-ukb-pilot/uk_biobank/categories/health_outcomes_externally_sourced_health_outcomes_death_register.json",
  "title": "Health outcomes — Externally sourced health outcomes: Death register",
  "description": "UK Biobank fields in the category Health outcomes > Externally sourced health outcomes > Death register, as selected by the CD3 researchers.",
  "type": "object",
  "x-variable-group": "health_outcomes_externally_sourced_health_outcomes_death_register",
  "properties": {
    "f40000": {
      "title": "Date of death",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
      "$comment": "Date format YYYY-MM-DD (ISO 8601) is assumed, not stated by the source (D015)."
    },
    "f40001": {
      "title": "Underlying (primary) cause of death: ICD10",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^([A-Z][0-9]{2,4}|[A-Z][0-9]{2}[A-Z]|[A-Z][0-9]{2}[A-Z][0-9])$",
      "$comment": "Source coding: encoding 19. The source lists 18904 codes, over the 300-code limit, so membership of the list is not checked: the schema asserts only text of the same shape as the listed codes, built from them (D047)."
    },
    "f40002": {
      "title": "Contributory (secondary) causes of death: ICD10",
      "type": [
        "array",
        "null"
      ],
      "uniqueItems": false,
      "minItems": 0,
      "maxItems": 15,
      "items": {
        "type": "string",
        "pattern": "^([A-Z][0-9]{2,4}|[A-Z][0-9]{2}[A-Z]|[A-Z][0-9]{2}[A-Z][0-9])$"
      },
      "$comment": "Source coding: encoding 19. Up to 15 entries, stored as an array in one field (D021). The source lists 18904 codes, over the 300-code limit, so membership of the list is not checked: the schema asserts only text of the same shape as the listed codes, built from them (D047)."
    },
    "f40007": {
      "title": "Age at death",
      "x-unit": "years",
      "type": [
        "number",
        "null"
      ]
    },
    "f40010": {
      "title": "Description of cause of death",
      "type": [
        "string",
        "null"
      ],
      "$comment": "The source states no format for this compound value, so any text is accepted."
    },
    "f40018": {
      "title": "Death record format",
      "oneOf": [
        {
          "const": 1,
          "title": "IC Death Format (2011 and earlier)"
        },
        {
          "const": 2,
          "title": "IC Death Format (2012 onwards)"
        },
        {
          "const": 7,
          "title": "Scottish Morbidity Record (SMR)"
        },
        {
          "const": 19,
          "title": "Scottish Morbidity Record (SMR) 99B - 2015"
        },
        {
          "const": 52,
          "title": "English and Welsh death (2020 onwards)"
        },
        {
          "const": 54,
          "title": "Scottish deaths (2017 - Jan 2018)"
        },
        {
          "const": 55,
          "title": "Scottish deaths (2018 onwards)"
        },
        {
          "type": "null"
        }
      ],
      "$comment": "Source coding: encoding 261."
    },
    "f40020": {
      "title": "Death record origin",
      "oneOf": [
        {
          "const": "E/W",
          "title": "Originating from England/Wales"
        },
        {
          "const": "HES",
          "title": "Hospital Episode Statistics from England"
        },
        {
          "const": "NCIN",
          "title": "National Cancer Intelligence Network"
        },
        {
          "const": "NHSE",
          "title": "NHS England"
        },
        {
          "const": "PEDW",
          "title": "Patient Episode Database for Wales"
        },
        {
          "const": "PHS",
          "title": "Public Health Scotland"
        },
        {
          "const": "SAIL",
          "title": "Secure Anonymised Information Linkage databank for Wales"
        },
        {
          "const": "SCOT",
          "title": "Originating from Scotland"
        },
        {
          "const": "SMR",
          "title": "Scottish Morbidity Records"
        },
        {
          "type": "null"
        }
      ],
      "$comment": "Source coding: encoding 1970."
    }
  },
  "required": [
    "f40000",
    "f40001",
    "f40002",
    "f40007",
    "f40010",
    "f40018",
    "f40020"
  ]
}
